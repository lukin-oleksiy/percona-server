--echo #
--echo # Language router: CREATE LIBRARY routing (02-router.md section 6, P2-1).
--echo # ECHO provides the library services, SHOUT does not (like js_lang).
--echo #

--source include/have_test_lang_components.inc
--source include/have_lang_router_component.inc
--source include/count_sessions.inc

INSTALL COMPONENT "file://component_test_lang_shout";
INSTALL COMPONENT "file://component_test_lang_echo";
INSTALL COMPONENT "file://component_lang_router";

--echo #
--echo # 1. ECHO libraries are validated by ECHO.
--echo #
CREATE LIBRARY e_lib LANGUAGE ECHO AS $$ any text $$;
SHOW WARNINGS;
--error ER_LANGUAGE_COMPONENT
CREATE LIBRARY e_bad LANGUAGE ECHO AS $$ SYNTAX_ERROR $$;
--echo # Language names are case-insensitive.
CREATE LIBRARY e_lc LANGUAGE echo AS $$ lower case $$;
SHOW CREATE LIBRARY e_lib;

--echo #
--echo # 2. SHOUT has no library services: the body is stored without
--echo #    validation, with the same warning as without the router (P2-1).
--echo #
CREATE LIBRARY s_lib LANGUAGE SHOUT AS $$ x $$;
SHOW WARNINGS;
CREATE LIBRARY s_unchecked LANGUAGE SHOUT AS $$ SYNTAX_ERROR $$;
SHOW WARNINGS;

--echo #
--echo # 3. No backend supports the language: error. (With js_lang alone this
--echo #    was a warning; with a backend that has library services, as here,
--echo #    it was already an error.)
--echo #
--error ER_LIBRARIES_NOT_SUPPORTED
CREATE LIBRARY n_lib LANGUAGE NOPE AS $$ x $$;

SELECT library_schema, library_name, language
  FROM information_schema.libraries
  WHERE library_schema = 'test' ORDER BY library_name;

--echo #
--echo # 4. Backend uninstalled and installed again: the cached backend is
--echo #    forgotten, then found again.
--echo #
UNINSTALL COMPONENT "file://component_test_lang_echo";
--error ER_LIBRARIES_NOT_SUPPORTED
CREATE LIBRARY e_gone LANGUAGE ECHO AS $$ x $$;
CREATE LIBRARY s_still LANGUAGE SHOUT AS $$ x $$;
INSTALL COMPONENT "file://component_test_lang_echo";
CREATE LIBRARY e_back LANGUAGE ECHO AS $$ x $$;
--error ER_LANGUAGE_COMPONENT
CREATE LIBRARY e_bad LANGUAGE ECHO AS $$ SYNTAX_ERROR $$;

--echo #
--echo # 5. Router uninstalled: SHOUT (the previous default) gets the execution
--echo #    services back. It has no library services, so the registry makes
--echo #    ECHO's library services the default, as before the router.
--echo #
UNINSTALL COMPONENT "file://component_lang_router";
CREATE LIBRARY e_after LANGUAGE ECHO AS $$ x $$;
--error ER_LIBRARIES_NOT_SUPPORTED
CREATE LIBRARY s_after LANGUAGE SHOUT AS $$ x $$;
CREATE FUNCTION s1(s VARCHAR(50)) RETURNS VARCHAR(50) LANGUAGE SHOUT AS $$ $$;
SELECT s1('shout is the default again') AS r;
DROP FUNCTION s1;

--echo #
--echo # Cleanup
--echo #
DROP LIBRARY e_lib;
DROP LIBRARY e_lc;
DROP LIBRARY s_lib;
DROP LIBRARY s_unchecked;
DROP LIBRARY s_still;
DROP LIBRARY e_back;
DROP LIBRARY e_after;
UNINSTALL COMPONENT "file://component_test_lang_echo";
UNINSTALL COMPONENT "file://component_test_lang_shout";
--source include/wait_until_count_sessions.inc
