#
# Language router: sysvar lang_router.language_map, status variables and
# error log messages (02-router.md sections 4 and 9, P2-4, P2-6).
# Both test backends also support LANGUAGE TWIN: ECHO returns the
# argument as is, SHOUT upper-cases it.
#
call mtr.add_suppression("Component lang_router reported");
SELECT MAX(logged) INTO @log_start FROM performance_schema.error_log;
#
# 1. A routine cached before the router (fallback path), then status.
#
INSTALL COMPONENT "file://component_test_lang_echo";
INSTALL COMPONENT "file://component_test_lang_shout";
CREATE FUNCTION e1(s VARCHAR(50)) RETURNS VARCHAR(50) LANGUAGE ECHO AS $$ $$;
SELECT e1('before router') AS r;
r
before router
INSTALL COMPONENT "file://component_lang_router";
SELECT @@global.lang_router.language_map;
@@global.lang_router.language_map
NULL
SHOW GLOBAL STATUS LIKE 'Lang_router%';
Variable_name	Value
Lang_router_backends	2
Lang_router_fallback_routed	0
Lang_router_languages	0
Lang_router_live_handles	0
SELECT e1('fallback') AS r;
r
fallback
SHOW GLOBAL STATUS LIKE 'Lang_router%';
Variable_name	Value
Lang_router_backends	2
Lang_router_fallback_routed	1
Lang_router_languages	0
Lang_router_live_handles	0
#
# 2. Two backends support TWIN and there is no language_map entry: the
#    first one (registry name order: test_lang_echo) wins, with a
#    warning in the error log.
#
CREATE FUNCTION t1(s VARCHAR(50)) RETURNS VARCHAR(50) LANGUAGE TWIN AS $$ $$;
SELECT t1('twin') AS r;
r
twin
SHOW GLOBAL STATUS LIKE 'Lang_router_languages';
Variable_name	Value
Lang_router_languages	1
SELECT prio, data FROM performance_schema.error_log WHERE data LIKE '%lang_router reported%' AND logged > @log_start ORDER BY logged;
prio	data
Note	Component lang_router reported: 'Installed; it routes stored programs by LANGUAGE. Routines cached before the install run in test_lang_echo.'
Warning	Component lang_router reported: 'LANGUAGE TWIN is supported by test_lang_echo, test_lang_shout; using test_lang_echo. Set lang_router.language_map to choose.'
Note	Component lang_router reported: 'LANGUAGE TWIN is routed to test_lang_echo.'
SELECT MAX(logged) INTO @log_start FROM performance_schema.error_log;
#
# 3. language_map chooses SHOUT. The cache is cleared; routines already
#    parsed in a session keep their backend, new ones use the map.
#
SET GLOBAL lang_router.language_map = 'twin=test_lang_shout';
SELECT @@global.lang_router.language_map;
@@global.lang_router.language_map
twin=test_lang_shout
SHOW GLOBAL STATUS LIKE 'Lang_router_languages';
Variable_name	Value
Lang_router_languages	0
SELECT t1('same session, old handle') AS r;
r
same session, old handle
SELECT t1('new session') AS r;
r
NEW SESSION
SELECT prio, data FROM performance_schema.error_log WHERE data LIKE '%lang_router reported%' AND logged > @log_start ORDER BY logged;
prio	data
Note	Component lang_router reported: 'LANGUAGE TWIN is routed to test_lang_shout.'
SELECT MAX(logged) INTO @log_start FROM performance_schema.error_log;
#
# 4. Syntax is checked on SET (backends may be installed later, so
#    unknown component names are accepted).
#
SET GLOBAL lang_router.language_map = 'JS';
ERROR 42000: Variable 'lang_router.language_map' can't be set to the value of 'JS'
SET GLOBAL lang_router.language_map = 'JS=js_lang,js=other';
ERROR 42000: Variable 'lang_router.language_map' can't be set to the value of 'JS=js_lang,js=other'
SET GLOBAL lang_router.language_map = 'J S=js_lang';
ERROR 42000: Variable 'lang_router.language_map' can't be set to the value of 'J S=js_lang'
SET GLOBAL lang_router.language_map = '=js_lang';
ERROR 42000: Variable 'lang_router.language_map' can't be set to the value of '=js_lang'
SET GLOBAL lang_router.language_map = 'JS=';
ERROR 42000: Variable 'lang_router.language_map' can't be set to the value of 'JS='
SET GLOBAL lang_router.language_map = 'JS=js_lang,';
ERROR 42000: Variable 'lang_router.language_map' can't be set to the value of 'JS=js_lang,'
SET GLOBAL lang_router.language_map = 'JS=js-lang';
ERROR 42000: Variable 'lang_router.language_map' can't be set to the value of 'JS=js-lang'
SET SESSION lang_router.language_map = 'JS=js_lang';
ERROR HY000: Variable 'lang_router.language_map' is a GLOBAL variable and should be set with SET GLOBAL
SELECT @@global.lang_router.language_map AS unchanged;
unchanged
twin=test_lang_shout
SET GLOBAL lang_router.language_map = ' JS = js_lang , TWIN=test_lang_shout ';
SELECT @@global.lang_router.language_map;
@@global.lang_router.language_map
 JS = js_lang , TWIN=test_lang_shout 
SET GLOBAL lang_router.language_map = '';
SELECT @@global.lang_router.language_map;
@@global.lang_router.language_map

SET GLOBAL lang_router.language_map = DEFAULT;
SELECT @@global.lang_router.language_map;
@@global.lang_router.language_map
NULL
#
# 5. Entries that cannot be used are ignored with a warning, and
#    discovery decides: a component that is not installed, and one that
#    does not support the language.
#
SET GLOBAL lang_router.language_map = 'TWIN=nope_lang,ECHO=test_lang_shout';
SELECT t1('twin') AS t, e1('echo') AS e;
t	e
twin	echo
SELECT prio, data FROM performance_schema.error_log WHERE data LIKE '%lang_router reported%' AND logged > @log_start ORDER BY logged;
prio	data
Warning	Component lang_router reported: 'lang_router.language_map entry TWIN=nope_lang is ignored: no installed language component nope_lang supports LANGUAGE TWIN.'
Warning	Component lang_router reported: 'LANGUAGE TWIN is supported by test_lang_echo, test_lang_shout; using test_lang_echo. Set lang_router.language_map to choose.'
Warning	Component lang_router reported: 'lang_router.language_map entry ECHO=test_lang_shout is ignored: no installed language component test_lang_shout supports LANGUAGE ECHO.'
SELECT MAX(logged) INTO @log_start FROM performance_schema.error_log;
#
# 6. Live handles: the default connection holds t1. Its e1 handle was
#    created before the router (fallback path) and is not counted.
#
SHOW GLOBAL STATUS LIKE 'Lang_router_live_handles';
Variable_name	Value
Lang_router_live_handles	1
SELECT t1('one more') AS r;
r
one more
SHOW GLOBAL STATUS LIKE 'Lang_router_live_handles';
Variable_name	Value
Lang_router_live_handles	2
#
# 7. A persisted value is applied at startup; an invalid value from the
#    command line is ignored with a warning.
#
SET PERSIST lang_router.language_map = 'TWIN=test_lang_shout';
# restart
SELECT @@global.lang_router.language_map;
@@global.lang_router.language_map
TWIN=test_lang_shout
SELECT t1('after restart') AS r;
r
AFTER RESTART
RESET PERSIST lang_router.language_map;
# restart: --loose-lang_router.language_map=TWIN
SELECT @@global.lang_router.language_map;
@@global.lang_router.language_map
TWIN
SELECT t1('invalid value ignored') AS r;
r
invalid value ignored
SELECT prio, data FROM performance_schema.error_log WHERE data LIKE '%language_map%' ORDER BY logged;
prio	data
Warning	Component lang_router reported: 'lang_router.language_map value 'TWIN' is invalid and is ignored.'
Warning	Component lang_router reported: 'LANGUAGE TWIN is supported by test_lang_echo, test_lang_shout; using test_lang_echo. Set lang_router.language_map to choose.'
# restart:
SELECT MAX(logged) INTO @log_start FROM performance_schema.error_log;
#
# 8. Router uninstalled: the successor is logged, and the status and
#    system variables are gone.
#
UNINSTALL COMPONENT "file://component_lang_router";
SELECT prio, data FROM performance_schema.error_log WHERE data LIKE '%lang_router reported%' AND logged > @log_start ORDER BY logged;
prio	data
Note	Component lang_router reported: 'Uninstalled; test_lang_echo is the default language component again.'
SHOW GLOBAL STATUS LIKE 'Lang_router%';
Variable_name	Value
SELECT @@global.lang_router.language_map;
ERROR HY000: Unknown system variable 'lang_router.language_map'
#
# Cleanup
#
DROP FUNCTION e1;
DROP FUNCTION t1;
UNINSTALL COMPONENT "file://component_test_lang_shout";
UNINSTALL COMPONENT "file://component_test_lang_echo";
