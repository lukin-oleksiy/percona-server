Warning	1287	'BINARY expr' is deprecated and will be removed in a future release. Please use CAST instead
Warning	1287	'BINARY expr' is deprecated and will be removed in a future release. Please use CAST instead
Warning	1287	'BINARY expr' is deprecated and will be removed in a future release. Please use CAST instead
Warning	1287	'BINARY expr' is deprecated and will be removed in a future release. Please use CAST instead
Warning	1287	'BINARY expr' is deprecated and will be removed in a future release. Please use CAST instead
# Each round: all workers connect, then the default connection starts
# to uninstall the router and the workers start a short CALL (in
# varying order and timing); then
# the workers disconnect (freeing their handles) and the router is
# installed again if it was uninstalled.
# No result came from a wrong backend.
SELECT COUNT(DISTINCT worker) AS workers, SUM(wrong) AS wrong FROM results;
workers	wrong
8	0
# All handles are released: the router uninstalls cleanly.
UNINSTALL COMPONENT "file://component_lang_router";
#
# Cleanup
#
DROP PROCEDURE worker;
DROP FUNCTION e1;
DROP FUNCTION s1;
DROP TABLE results;
UNINSTALL COMPONENT "file://component_js_lang";
UNINSTALL COMPONENT "file://component_test_lang_shout";
UNINSTALL COMPONENT "file://component_test_lang_echo";
